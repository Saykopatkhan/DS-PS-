# Copy to .env in the project root. Environment variables take precedence.
DS_IPS_INTERFACE=any
DS_IPS_MODE=ids
DS_IPS_WIFI=false
DS_IPS_DRY_RUN=false
# Correlate observations first; enable temporary automatic IP blocks only after
# reviewing incidents and configuring protected infrastructure in /etc/dsips/config.json.
# Requires IPS mode, running monitoring, verified local evidence and score >= 80.
DS_IPS_AUTO_RESPONSE=false
DS_IPS_DB=ds_ips.db
DS_IPS_UNBAN_TIME=3600
DS_IPS_BIND=127.0.0.1:5000
DS_IPS_HIDS=true
DS_IPS_TELEGRAM=false
# Set to true only behind your own proxy with the backend bound to loopback.
DS_IPS_TRUST_PROXY=false
# Enable with an HTTPS reverse proxy.
DS_IPS_COOKIE_SECURE=false
DS_IPS_USER=admin
# Optional fixed credentials. Otherwise a password is generated on startup.
# DS_IPS_PASSWORD=replace-with-a-long-random-password
# DS_IPS_SECRET_KEY=replace-with-at-least-32-random-bytes
# BOT_TOKEN=
# CHAT_ID=
