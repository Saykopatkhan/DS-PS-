# Install using setup_nginx.sh; placeholders are replaced after validation.
limit_req_zone $binary_remote_addr zone=ds_ips_login_limit:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=ds_ips_conn_limit:10m;
map $http_upgrade $ds_ips_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;
    return 301 https://__SERVER_NAME__$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __SERVER_NAME__;
    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 30s;
    client_max_body_size 1M;
    limit_conn ds_ips_conn_limit 30;
    limit_req_status 429;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $ds_ips_connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    location = /login {
        limit_req zone=ds_ips_login_limit burst=5 nodelay;
        proxy_pass http://127.0.0.1:5000;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
    }

    location /socket.io/ {
        proxy_buffering off;
        proxy_pass http://127.0.0.1:5000;
    }
}
